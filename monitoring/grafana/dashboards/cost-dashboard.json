{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "description": "Total ML spend over the selected window, all categories.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 500 },
              { "color": "red", "value": 1000 }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(astroml_cost_usd_total[$__range]))",
          "legendFormat": "total",
          "refId": "A"
        }
      ],
      "title": "Total spend",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Compute spend (GPU/CPU hours) over the selected window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(astroml_cost_usd_total{category=\"compute\"}[$__range]))",
          "legendFormat": "compute",
          "refId": "A"
        }
      ],
      "title": "Compute spend",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "External API spend over the selected window.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(increase(astroml_cost_usd_total{category=\"api\"}[$__range]))",
          "legendFormat": "api",
          "refId": "A"
        }
      ],
      "title": "API spend",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "Highest budget utilization across all configured budgets. 100% means a budget is exhausted.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "orientation": "auto",
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "expr": "max(astroml_budget_utilization_ratio)",
          "legendFormat": "peak utilization",
          "refId": "A"
        }
      ],
      "title": "Peak budget utilization",
      "type": "gauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Daily spend split by cost category.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal" } },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (category) (increase(astroml_cost_usd_total[1d]))",
          "legendFormat": "{{category}}",
          "refId": "A"
        }
      ],
      "title": "Daily spend by category",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Daily spend allocated by project.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 30, "lineWidth": 1, "stacking": { "mode": "normal" } },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 6 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["sum"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum by (project) (increase(astroml_cost_usd_total{project=~\"$project\"}[1d]))",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Daily spend by project",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "description": "Spend per compute resource class (GPU/CPU/memory).",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "id": 7,
      "options": {
        "displayLabels": ["percent"],
        "legend": { "displayMode": "table", "placement": "right", "values": ["value"] },
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false }
      },
      "targets": [
        {
          "expr": "sum by (resource) (increase(astroml_cost_usd_total{category=\"compute\"}[$__range]))",
          "legendFormat": "{{resource}}",
          "refId": "A"
        }
      ],
      "title": "Compute spend by resource",
      "type": "piechart"
    },
    {
      "datasource": "Prometheus",
      "description": "Budget consumption per budget. Values above 1 are over budget.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "max": 1.25,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.8 },
              { "color": "red", "value": 1 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "id": 8,
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false },
        "showUnfilled": true
      },
      "targets": [
        {
          "expr": "astroml_budget_utilization_ratio",
          "legendFormat": "{{budget}}",
          "refId": "A"
        }
      ],
      "title": "Budget utilization",
      "type": "bargauge"
    },
    {
      "datasource": "Prometheus",
      "description": "Estimated monthly saving available from open optimization recommendations.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "orange", "value": 250 }
            ]
          },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calc": "lastNotNull", "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum(astroml_cost_optimization_saving_usd)",
          "legendFormat": "addressable saving",
          "refId": "A"
        }
      ],
      "title": "Addressable monthly saving",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "description": "30-day spend forecast from the current daily burn rate.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 23 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "expr": "sum(astroml_cost_forecast_usd)",
          "legendFormat": "30-day forecast",
          "refId": "A"
        },
        {
          "expr": "sum(astroml_cost_daily_rate_usd) * 30",
          "legendFormat": "burn-rate projection",
          "refId": "B"
        }
      ],
      "title": "Spend forecast",
      "type": "timeseries"
    }
  ],
  "refresh": "5m",
  "schemaVersion": 27,
  "style": "dark",
  "tags": ["astroml", "cost", "finops", "mlops"],
  "templating": {
    "list": [
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "Prometheus",
        "definition": "label_values(astroml_cost_usd_total, project)",
        "includeAll": true,
        "label": "Project",
        "multi": true,
        "name": "project",
        "query": "label_values(astroml_cost_usd_total, project)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": "Prometheus",
        "definition": "label_values(astroml_cost_usd_total, team)",
        "includeAll": true,
        "label": "Team",
        "multi": true,
        "name": "team",
        "query": "label_values(astroml_cost_usd_total, team)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-30d", "to": "now" },
  "timepicker": {},
  "timezone": "utc",
  "title": "AstroML ML Cost & Budget",
  "uid": "astroml-ml-cost",
